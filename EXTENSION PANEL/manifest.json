{
  "manifest_version": 2,
  "name": "Panel: Inbox, Baúl y agenda",
  "version": "2.5.0",
  "description": "Envía al Inbox de tu Panel lo que seleccionas o la página que ves (tarea, idea o paso de otra; prefijos t: i: r: e:), guarda enlaces en el Baúl y consulta y gestiona tu agenda. Funciona sin conexión: lo guarda y lo envía después.",
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "alarms",
    "notifications",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/login*", "https://*/login*"],
      "js": ["lib/panel.js", "autologin.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Panel: enviar al Inbox o al Baúl",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["lib/panel.js", "background.js"],
    "persistent": false
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Enviar al Inbox"
    },
    "open-vault": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Guardar en el Baúl"
    },
    "open-agenda": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Agenda: ver y crear eventos"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cerebro-digital-vault@tudominio.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
