# Copia este archivo a .env y rellénalo. .env NUNCA se sube a git.

# ── Acceso al panel ────────────────────────────────────────────
# Genera el hash, el secreto de sesión y (opcional) un token de API con:
#   python -m scripts.set_password
PANEL_PASSWORD_HASH=
PANEL_SESSION_SECRET=
# Token para scripts/atajos: cabecera "Authorization: Bearer <token>"
PANEL_API_TOKEN_HASH=
PANEL_SESSION_DAYS=30
# true solo si sirves el panel por HTTPS
PANEL_COOKIE_SECURE=false

# ── iCloud (CalDAV) ────────────────────────────────────────────
# Usa una contraseña de aplicación de appleid.apple.com, no la de tu cuenta.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
ICLOUD_CALENDAR_NAME=Panel estudio

# ── ESP32 (opcional) ───────────────────────────────────────────
# IP de la placa. Vacío = sin placa: no se intenta conectar y el resto del panel funciona igual.
ESP32_HOST=
# Dirección del panel vista desde la placa, para los enlaces de las notas de repaso
SERVER_BASE_URL=http://localhost:8000

# ── Opcionales ─────────────────────────────────────────────────
# PANEL_DATA_DIR=./data
# PANEL_LOG_LEVEL=INFO
# PANEL_DISABLE_BRIDGES=false
# PANEL_DISABLE_SCHEDULER=false
# Si tienes un repo de dotfiles, la página Copias lo enseña y lo sube a GitHub (ver docs/dotfiles.md)
# PANEL_DOTFILES_DIR=/home/usuario/dotfiles
# PANEL_DOTFILES_HOME=/home/usuario
# Solo si retocaste el repo a mano tras copiar tu ~ : el último commit con los archivos tal cual
# PANEL_DOTFILES_BASE=
